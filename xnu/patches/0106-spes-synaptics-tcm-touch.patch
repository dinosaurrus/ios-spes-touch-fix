+/* Synaptics TCM at the stock SPES KHAJE IDP overlay address 0x20.
+ * The TCM I2C transport is raw: unlike FocalTech it has no register pointer.
+ * Message format and report tokens mirror Xiaomi's synaptics_tcm driver. */
+#define TOUCH_TCM_ADDR       0x20u
+#define TOUCH_TCM_MARKER     0xa5u
+#define TOUCH_TCM_PADDING    0x5au
+#define TOUCH_TCM_CONT_READ  0x03u
+#define TOUCH_TCM_CONT_WRITE 0x01u
+#define TOUCH_TCM_IDENTIFY   0x02u
+#define TOUCH_TCM_ENABLE     0x05u
+#define TOUCH_TCM_GET_APP    0x20u
+#define TOUCH_TCM_SET_CFG    0x26u
+#define TOUCH_TCM_TOUCH      0x11u
+#define TOUCH_TCM_APP_MODE   0x01u
+#define TOUCH_TCM_CFG_MAX    256u
+
+static unsigned
+ touch_le16(const uint8_t *p)
+{
+	return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+static int
+ touch_tcm_read_message(uint8_t *code, uint8_t *data, unsigned cap, unsigned *len)
+{
+	uint8_t b[90];
+	int err = touch_msg(TOUCH_TCM_ADDR, NULL, 0, b, 9, false);
+	if (err) return err;
+	if (b[0] != TOUCH_TCM_MARKER) return EAGAIN;
+	*code = b[1];
+	*len = touch_le16(b + 2);
+	if (*len > cap || *len > TOUCH_TCM_CFG_MAX) return EMSGSIZE;
+	unsigned copied = *len < 5u ? *len : 5u;
+	if (copied) memcpy(data, b + 4, copied);
+	unsigned total = 4u + *len + 1u;
+	if (total <= 9u) {
+		if (b[total - 1u] != TOUCH_TCM_PADDING) return EIO;
+		return 0;
+	}
+	unsigned remain = total - 9u;
+	unsigned off = copied;
+	while (remain) {
+		unsigned n = remain > 88u ? 88u : remain;
+		if (n == 1u) { /* Synaptics pads the final byte without another I2C read. */
+			if (off != *len) return EIO;
+			remain = 0;
+			break;
+		}
+		err = touch_msg(TOUCH_TCM_ADDR, NULL, 0, b, n + 2u, false);
+		if (err) return err;
+		if (b[0] != TOUCH_TCM_MARKER || b[1] != TOUCH_TCM_CONT_READ)
+			return EIO;
+		unsigned payload = n;
+		if (off + payload > *len) payload = *len - off;
+		if (payload) memcpy(data + off, b + 2, payload);
+		off += payload;
+		if (payload < n && b[2u + payload] != TOUCH_TCM_PADDING) return EIO;
+		remain -= n;
+	}
+	if (off != *len) return EIO;
+	return 0;
+}
+
+static int
+ touch_tcm_write_command(uint8_t command, const uint8_t *payload, unsigned length)
+{
+	uint8_t first[3] = {command, (uint8_t)length, (uint8_t)(length >> 8)};
+	int err = touch_msg(TOUCH_TCM_ADDR, first, sizeof(first), NULL, 0, false);
+	if (err) return err;
+	for (unsigned off = 0; off < length; ) {
+		unsigned n = length - off;
+		if (n > 2u) n = 2u;
+		uint8_t part[3] = {TOUCH_TCM_CONT_WRITE, payload[off], 0};
+		if (n == 2u) part[2] = payload[off + 1u];
+		err = touch_msg(TOUCH_TCM_ADDR, part, n + 1u, NULL, 0, false);
+		if (err) return err;
+		/* Match Xiaomi's 500–1000 us inter-chunk delay. */
+		delay(1);
+		off += n;
+	}
+	return 0;
+}
+
+static int
+ touch_tcm_wait(uint8_t wanted, uint8_t *data, unsigned cap, unsigned *len)
+{
+	for (unsigned i = 0; i < 300u; ++i) {
+		uint8_t code = 0;
+		unsigned n = 0;
+		int err = touch_tcm_read_message(&code, data, cap, &n);
+		if (!err) {
+			if (code == wanted) { *len = n; return 0; }
+			if (code == 0x0fu || code == 0xffu) return EIO;
+		} else if (err != EAGAIN && err != ENXIO) {
+			return err;
+		}
+		delay(10000); /* 10 ms, up to the stock driver's 3 s response timeout */
+	}
+	return ETIMEDOUT;
+}
+
+static int
+ touch_tcm_command(uint8_t command, const uint8_t *payload, unsigned length,
+    uint8_t *response, unsigned cap, unsigned *response_length)
+{
+	int err = touch_tcm_write_command(command, payload, length);
+	if (err) return err;
+	return touch_tcm_wait(0x01u, response, cap, response_length);
+}
+
+static unsigned
+ touch_tcm_bits(const uint8_t *p, unsigned bit, unsigned count)
+{
+	unsigned value = 0;
+	for (unsigned i = 0; i < count; ++i)
+		value |= ((p[(bit + i) >> 3] >> ((bit + i) & 7u)) & 1u) << i;
+	return value;
+}
+
+static int
+ touch_tcm_frame(const uint8_t *p, unsigned len, unsigned max_objects,
+    unsigned max_x, unsigned max_y)
+{
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	if ((len & 3u) || len / 4u > max_objects || max_objects > TOUCH_MAX)
+		return EIO;
+	for (unsigned off = 0; off < len; off += 4u) {
+		const uint8_t *r = p + off;
+		unsigned id = touch_tcm_bits(r, 0, 4);
+		unsigned cls = touch_tcm_bits(r, 4, 4);
+		unsigned px = touch_tcm_bits(r, 8, 12);
+		unsigned py = touch_tcm_bits(r, 20, 12);
+		if (id >= max_objects || (mask & (1u << id)) || px > max_x || py > max_y)
+			return EIO;
+		if (cls == 1u || cls == 2u) {
+			mask |= 1u << id;
+			x[id] = (int)((uint64_t)px * 1079u / max_x);
+			y[id] = (int)((uint64_t)py * 2399u / max_y);
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+ touch_tcm_init(unsigned *max_x, unsigned *max_y, unsigned *max_objects)
+{
+	uint8_t data[TOUCH_TCM_CFG_MAX], cfg[TOUCH_TCM_CFG_MAX];
+	unsigned len = 0;
+	uint8_t code = 0;
+	int err;
+	/* Synaptics DT: active-low reset for 20 ms, then 200 ms boot settle. */
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);
+	touch_wait(20);
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, true);
+	touch_wait(200);
+	err = touch_tcm_write_command(TOUCH_TCM_IDENTIFY, NULL, 0);
+	if (!err) err = touch_tcm_wait(0x10u, data, sizeof(data), &len);
+	if (err || len < 24u || data[1] != TOUCH_TCM_APP_MODE) {
+		printf("SWEET TCM: identify failed err=%d len=%u mode=%#x\n",
+		    err, len, len > 1u ? data[1] : 0u);
+		return false;
+	}
+	printf("SWEET TCM: application mode identify OK\n");
+	err = touch_tcm_command(TOUCH_TCM_GET_APP, NULL, 0, data, sizeof(data), &len);
+	if (err || len < 38u || touch_le16(data + 2) != 0u) {
+		printf("SWEET TCM: app info failed err=%d len=%u status=%#x\n",
+		    err, len, len >= 4u ? touch_le16(data + 2) : 0u);
+		return false;
+	}
+	*max_x = touch_le16(data + 32);
+	*max_y = touch_le16(data + 34);
+	*max_objects = touch_le16(data + 36);
+	unsigned cfg_size = touch_le16(data + 12);
+	if (!*max_x || !*max_y || !*max_objects || *max_objects > TOUCH_MAX ||
+	    cfg_size < 11u || cfg_size > sizeof(cfg)) {
+		printf("SWEET TCM: invalid app geometry %ux%u objects=%u cfg=%u\n",
+		    *max_x, *max_y, *max_objects, cfg_size);
+		return false;
+	}
+	memset(cfg, 0, cfg_size);
+	/* Same extend_report layout as synaptics_tcm_touch.c: active-object
+	 * foreach, index(4), classification(4), X(12), Y(12), end. */
+	const uint8_t fields[] = {1, 6, 4, 7, 4, 8, 12, 9, 12, 3, 0};
+	memcpy(cfg, fields, sizeof(fields));
+	err = touch_tcm_command(TOUCH_TCM_SET_CFG, cfg, cfg_size,
+	    data, sizeof(data), &len);
+	if (err) {
+		printf("SWEET TCM: set report config failed err=%d\n", err);
+		return false;
+	}
+	const uint8_t report_id = TOUCH_TCM_TOUCH;
+	err = touch_tcm_command(TOUCH_TCM_ENABLE, &report_id, 1,
+	    data, sizeof(data), &len);
+	if (err) {
+		printf("SWEET TCM: enable touch report failed err=%d\n", err);
+		return false;
+	}
+	printf("SWEET TCM: reports enabled geometry=%ux%u objects=%u cfg=%u\n",
+	    *max_x, *max_y, *max_objects, cfg_size);
+	return true;
+}
+
+static int
+ touch_tcm_poll(unsigned max_objects, unsigned max_x, unsigned max_y)
+{
+	uint8_t data[TOUCH_TCM_CFG_MAX], code = 0;
+	unsigned len = 0;
+	int err = touch_tcm_read_message(&code, data, sizeof(data), &len);
+	if (err == EAGAIN) return 0;
+	if (err) return err;
+	if (code == TOUCH_TCM_TOUCH)
+		return touch_tcm_frame(data, len, max_objects, max_x, max_y);
+	if (code == 0x00u || code == 0x02u || code == 0x03u) return 0;
+	return 0;
+}
