+
+/*
+ * Khaje/SM6225 RPM is GLINK over its dedicated RPM message RAM. This is a
+ * one-shot, polled client for the PM6125 L9A touch rail. Refuse to initialize
+ * if either FIFO is non-empty: a second GLINK VERSION handshake can crash RPM.
+ */
+#define TOUCH_RPM_RAM_PA       0x045f0000u
+#define TOUCH_RPM_RAM_SIZE     0x7000u
+#define TOUCH_RPM_TOC_SIZE     256u
+#define TOUCH_RPM_TOC_MAGIC    0x67727430u /* grt0 */
+#define TOUCH_RPM_TX_ID        0x61703272u /* ap2r */
+#define TOUCH_RPM_RX_ID        0x72326170u /* r2ap */
+#define TOUCH_RPM_APCS_PA      0x0f111008u /* APCS IPC, RPM doorbell bit 0 */
+#define TOUCH_RPM_VERSION      0u
+#define TOUCH_RPM_VERSION_ACK  1u
+#define TOUCH_RPM_OPEN         2u
+#define TOUCH_RPM_OPEN_ACK     4u
+#define TOUCH_RPM_TX_DATA      9u
+#define TOUCH_RPM_CLOSE_ACK    11u
+#define TOUCH_RPM_TX_CONT      12u
+#define TOUCH_RPM_READ_NOTIF   13u
+#define TOUCH_RPM_SIGNALS      15u
+#define TOUCH_RPM_LCID         1u
+#define TOUCH_RPM_SERVICE_REQ  0x00716572u /* req */
+#define TOUCH_RPM_MSG_ID       0x2367736du /* msg# */
+#define TOUCH_RPM_MSG_ERR      0x00727265u /* err */
+#define TOUCH_RPM_LDOA         0x616f646cu /* ldoa */
+#define TOUCH_RPM_SWEN         0x6e657773u /* swen */
+#define TOUCH_RPM_UV           0x00007675u /* uv */
+
+struct touch_rpm_fifo {
+	uint32_t off, size;
+};
+
+static struct {
+	vm_offset_t ram, apcs;
+	struct touch_rpm_fifo tx, rx;
+	uint32_t msgid;
+	int32_t ack;
+	bool version, opened, remote_open, error;
+	uint16_t rcid;
+} trpm;
+
+static uint32_t
+rpm_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(trpm.ram + off);
+}
+
+static void
+rpm_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(trpm.ram + off) = value;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static bool
+rpm_tx(const void *message, uint32_t length)
+{
+	const uint32_t *words = message;
+	uint32_t tail = rpm_rd(trpm.tx.off);
+	uint32_t head = rpm_rd(trpm.tx.off + 4);
+	uint32_t avail, i;
+
+	if ((length & 7u) || head >= trpm.tx.size || tail >= trpm.tx.size)
+		return false;
+	avail = tail <= head ? trpm.tx.size - head + tail : tail - head;
+	if (avail <= length)
+		return false;
+	for (i = 0; i < length; i += 4) {
+		*(volatile uint32_t *)(trpm.ram + trpm.tx.off + 8 + head) = words[i / 4];
+		head += 4;
+		if (head >= trpm.tx.size)
+			head -= trpm.tx.size;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	rpm_wr(trpm.tx.off + 4, head);
+	*(volatile uint32_t *)trpm.apcs = 1u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	return true;
+}
+
+static uint32_t
+rpm_rx_avail(void)
+{
+	uint32_t tail = rpm_rd(trpm.rx.off), head = rpm_rd(trpm.rx.off + 4);
+	if (head >= trpm.rx.size || tail >= trpm.rx.size)
+		return 0;
+	return head >= tail ? head - tail : trpm.rx.size - tail + head;
+}
+
+static void
+rpm_rx_copy(uint32_t at, void *dst, uint32_t length)
+{
+	uint32_t tail = rpm_rd(trpm.rx.off), i;
+	for (i = 0; i < length; i += 4) {
+		uint32_t pos = (tail + at + i) % trpm.rx.size;
+		*(uint32_t *)((uint8_t *)dst + i) = rpm_rd(trpm.rx.off + 8 + pos);
+	}
+}
+
+static void
+rpm_rx_advance(uint32_t length)
+{
+	uint32_t tail = rpm_rd(trpm.rx.off) + length;
+	if (tail >= trpm.rx.size)
+		tail -= trpm.rx.size;
+	rpm_wr(trpm.rx.off, tail);
+}
+
+static void
+rpm_parse_reply(const uint8_t *p, uint32_t length)
+{
+	uint32_t off = 8;
+	if (length < 8 || *(const uint32_t *)p != TOUCH_RPM_SERVICE_REQ) {
+		trpm.error = true;
+		return;
+	}
+	while (off + 8 <= length) {
+		uint32_t type = *(const uint32_t *)(p + off);
+		uint32_t size = *(const uint32_t *)(p + off + 4);
+		if (size > length - off - 8)
+			break;
+		if (type == TOUCH_RPM_MSG_ID && size >= 4)
+			trpm.ack = (int32_t)*(const uint32_t *)(p + off + 8);
+		else if (type == TOUCH_RPM_MSG_ERR)
+			trpm.error = true;
+		off += (8 + size + 3u) & ~3u;
+	}
+}
+
+static bool
+rpm_rx_one(void)
+{
+	uint32_t avail = rpm_rx_avail(), m[2], cmd, p1, n;
+	if (avail < 8)
+		return false;
+	rpm_rx_copy(0, m, 8);
+	cmd = m[0] & 0xffffu;
+	p1 = m[0] >> 16;
+	switch (cmd) {
+	case TOUCH_RPM_VERSION:
+		rpm_rx_advance(8);
+		(void)rpm_tx((uint32_t[2]){ TOUCH_RPM_VERSION_ACK | (1u << 16), 0 }, 8);
+		trpm.version = true;
+		break;
+	case TOUCH_RPM_VERSION_ACK:
+		rpm_rx_advance(8);
+		trpm.version = true;
+		break;
+	case TOUCH_RPM_OPEN: {
+		char name[36] = {0};
+		n = (8u + m[1] + 7u) & ~7u;
+		if (m[1] > 32u || avail < n)
+			return false;
+		rpm_rx_copy(8, name, (m[1] + 3u) & ~3u);
+		rpm_rx_advance(n);
+		if (strcmp(name, "rpm_requests") == 0) {
+			trpm.rcid = (uint16_t)p1;
+			trpm.remote_open = true;
+			(void)rpm_tx((uint32_t[2]){ TOUCH_RPM_OPEN_ACK | (p1 << 16), 0 }, 8);
+		}
+		break;
+	}
+	case TOUCH_RPM_OPEN_ACK:
+		rpm_rx_advance(8);
+		trpm.opened = p1 == TOUCH_RPM_LCID;
+		break;
+	case TOUCH_RPM_TX_DATA:
+	case TOUCH_RPM_TX_CONT: {
+		uint32_t c[2];
+		uint8_t data[256];
+		if (avail < 16)
+			return false;
+		rpm_rx_copy(8, c, 8);
+		n = (16u + c[0] + 7u) & ~7u;
+		if (c[0] > sizeof(data) || avail < n)
+			return false;
+		rpm_rx_copy(16, data, (c[0] + 3u) & ~3u);
+		rpm_parse_reply(data, c[0]);
+		rpm_rx_advance(n);
+		break;
+	}
+	case TOUCH_RPM_CLOSE_ACK:
+	case TOUCH_RPM_READ_NOTIF:
+	case TOUCH_RPM_SIGNALS:
+		rpm_rx_advance(8);
+		break;
+	default:
+		/* Preserve unknown bytes for diagnosis; do not desynchronize the link. */
+		return false;
+	}
+	return true;
+}
+
+static bool
+rpm_wait(bool (*done)(void), uint32_t timeout_ms)
+{
+	uint32_t i;
+	for (i = 0; i < timeout_ms; i++) {
+		while (rpm_rx_one()) { }
+		if (done())
+			return true;
+		touch_wait(1);
+	}
+	return false;
+}
+
+static bool rpm_version_done(void) { return trpm.version; }
+static bool rpm_open_done(void) { return trpm.opened && trpm.remote_open; }
+static bool rpm_request_done(void) { return trpm.error || trpm.ack == (int32_t)trpm.msgid; }
+
+static bool
+rpm_l9a_enable(void)
+{
+	uint32_t toc, count, i, found = 0, magic;
+	uint32_t open[6] = { TOUCH_RPM_OPEN | (TOUCH_RPM_LCID << 16), sizeof("rpm_requests"),
+		0x5f6d7072u, 0x75716572u, 0x73747365u, 0 };
+	bool ok = false;
+
+	trpm.ram = ml_io_map(TOUCH_RPM_RAM_PA, TOUCH_RPM_RAM_SIZE);
+	trpm.apcs = ml_io_map(TOUCH_RPM_APCS_PA & ~0xfffu, 0x1000u);
+	if (!trpm.ram || !trpm.apcs) {
+		printf("SWEET RPM: MMIO map failed\n");
+		return false;
+	}
+	trpm.apcs += TOUCH_RPM_APCS_PA & 0xfffu;
+	toc = TOUCH_RPM_RAM_SIZE - TOUCH_RPM_TOC_SIZE;
+	magic = rpm_rd(toc);
+	count = rpm_rd(toc + 4);
+	if (magic != TOUCH_RPM_TOC_MAGIC || count > (TOUCH_RPM_TOC_SIZE - 8u) / 12u) {
+		printf("SWEET RPM: bad TOC magic=%#x count=%u\n", magic, count);
+		return false;
+	}
+	for (i = 0; i < count; i++) {
+		uint32_t id = rpm_rd(toc + 8u + i * 12u);
+		uint32_t off = rpm_rd(toc + 12u + i * 12u);
+		uint32_t size = rpm_rd(toc + 16u + i * 12u);
+		if (off > TOUCH_RPM_RAM_SIZE || size > TOUCH_RPM_RAM_SIZE - off - 8u)
+			continue;
+		if (id == TOUCH_RPM_TX_ID) { trpm.tx.off = off; trpm.tx.size = size; found |= 1; }
+		if (id == TOUCH_RPM_RX_ID) { trpm.rx.off = off; trpm.rx.size = size; found |= 2; }
+	}
+	if (found != 3 || !trpm.tx.size || !trpm.rx.size) {
+		printf("SWEET RPM: AP2R/R2AP FIFO descriptors missing\n");
+		return false;
+	}
+	if (rpm_rd(trpm.tx.off) || rpm_rd(trpm.tx.off + 4) ||
+	    rpm_rd(trpm.rx.off) || rpm_rd(trpm.rx.off + 4)) {
+		printf("SWEET RPM: FIFO already used; refusing second handshake\n");
+		return false;
+	}
+	printf("SWEET RPM: clean RPM GLINK FIFOs tx=%#x/%#x rx=%#x/%#x\n",
+	    trpm.tx.off, trpm.tx.size, trpm.rx.off, trpm.rx.size);
+	trpm.ack = -1;
+	if (!rpm_tx((uint32_t[2]){ TOUCH_RPM_VERSION | (1u << 16), 0 }, 8) ||
+	    !rpm_wait(rpm_version_done, 1000)) {
+		printf("SWEET RPM: VERSION handshake timeout\n");
+		return false;
+	}
+	if (!rpm_tx(open, sizeof(open)) || !rpm_wait(rpm_open_done, 1000)) {
+		printf("SWEET RPM: rpm_requests OPEN timeout ack=%u remote=%u\n",
+		    trpm.opened, trpm.remote_open);
+		return false;
+	}
+	printf("SWEET RPM: rpm_requests open rcid=%u\n", trpm.rcid);
+	/* Match Linux qcom_smd-regulator: request the DT init voltage, then enable. */
+	for (unsigned step = 0; step < 2; step++) {
+		uint32_t key = step ? TOUCH_RPM_SWEN : TOUCH_RPM_UV;
+		uint32_t value = step ? 1u : 1800000u;
+		uint32_t req[14] = {
+			TOUCH_RPM_TX_DATA | (TOUCH_RPM_LCID << 16), 0,
+			40, 0,                         /* chunk bytes, remaining */
+			TOUCH_RPM_SERVICE_REQ, 32,     /* req service, request length */
+			step + 1, 0, TOUCH_RPM_LDOA, 9, 12, /* msg, active set, ldoa9, KVP */
+			key, 4, value
+		};
+		trpm.msgid = step + 1;
+		trpm.ack = -1;
+		trpm.error = false;
+		if (!rpm_tx(req, sizeof(req)) || !rpm_wait(rpm_request_done, 1000)) {
+			printf("SWEET RPM: L9A KVP %#x ACK timeout msg=%u\n", key, trpm.msgid);
+			return false;
+		}
+		ok = !trpm.error && trpm.ack == (int32_t)trpm.msgid;
+		if (!ok) {
+			printf("SWEET RPM: L9A KVP %#x rejected ack=%d\n", key, trpm.ack);
+			return false;
+		}
+	}
+	printf("SWEET RPM: L9A 1.8V active request ACKED\n");
+	return true;
+}
