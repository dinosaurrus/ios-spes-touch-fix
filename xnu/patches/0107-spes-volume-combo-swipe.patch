+static void
+keys_swipe_up(void)
+{
+	static const int y[] = { 2300, 1900, 1500, 1100, 700, 300 };
+	const int finger = 9;
+	for (unsigned i = 0; i < sizeof(y) / sizeof(y[0]); ++i) {
+		sweet_hid_touch(finger, 1, 540, y[i]);
+		delay(20);
+	}
+	sweet_hid_touch(finger, 0, 540, y[5]);
+}
