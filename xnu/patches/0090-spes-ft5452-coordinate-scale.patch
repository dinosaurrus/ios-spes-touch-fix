diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -472,10 +472,19 @@
 		}
 		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
 		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
-		/* Spes overlay declares the native 1080x2400 touch coordinate range. */
-		if (px > 1079 || py > 2399) {
+		/*
+		 * TopazTouch's FT5452 trace shows 12-bit coordinates 0..1349/2999
+		 * plus two fractional bits in p[4]. Convert the 1.25x raw range to
+		 * the iPhone X HID surface (1080x2400); rejecting at 1079/2399
+		 * discarded almost every point in the rightmost/bottommost fifth.
+		 */
+		unsigned px4 = (px << 2) | (p[4] >> 6);
+		unsigned py4 = (py << 2) | ((p[4] >> 4) & 3u);
+		if (px4 > 5399u || py4 > 11999u) {
 			return EIO;
 		}
+		px = (px4 * 1080u) / 5400u;
+		py = (py4 * 2400u) / 12000u;
 		mask |= 1u << id;
 		x[id] = (int)px;
 		y[id] = (int)py;
