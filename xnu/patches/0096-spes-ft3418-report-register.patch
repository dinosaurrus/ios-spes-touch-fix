diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -448,7 +448,8 @@ touch_focaltech(void)
 	uint8_t buf[63];
 	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
 	uint32_t mask = 0, seen = 0;
-	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	/* Spes FT3418 Linux driver sets the report pointer to register 0x01. */
+	int err = touch_read(0x38, 0x01, false, buf, sizeof(buf));
 	if (err) {
 		return err;
 	}
@@ -498,6 +499,11 @@ touch_focaltech(void)
 		x[id] = (int)px;
 		y[id] = (int)py;
 	}
+	if (mask && !st.active) {
+		unsigned id = (unsigned)__builtin_ctz(mask);
+		printf("SWEET TOUCH: FT3418 first contact mask=%#x x=%d y=%d\n",
+		    mask, x[id], y[id]);
+	}
 	touch_report(mask, x, y);
 	return 0;
 }
