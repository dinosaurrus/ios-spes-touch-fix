diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -445,18 +445,20 @@
 {
 	uint8_t buf[63];
 	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
 	uint32_t mask = 0, seen = 0;
-	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	/* Xiaomi Spes FocalTech driver selects report register 0x01. */
+	int err = touch_read(0x38, 1, false, buf, sizeof(buf));
 	if (err) {
 		return err;
 	}
-	unsigned n = buf[2] & 15u, active = 0;
-	if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+	/* Register 0x01 data is buf[0]; touch count is register 0x02. */
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
 		return EIO;
 	}
 	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
-		const uint8_t *p = buf + 3u + 6u * i;
+		const uint8_t *p = buf + 2u + 6u * i;
 		unsigned id = p[2] >> 4, event = p[0] >> 6;
 		if (id >= TOUCH_MAX) {
 			break; /* vendor's unused-record sentinel */
 		}
@@ -471,19 +473,15 @@
 			return EIO;
 		}
 		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
 		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
-		/* Spes overlay declares the native 1080x2400 touch coordinate range. */
+		/* Xiaomi FT3418 report uses native 12-bit X/Y; Spes is 1080x2400. */
 		if (px > 1079 || py > 2399) {
 			return EIO;
 		}
 		mask |= 1u << id;
 		x[id] = (int)px;
 		y[id] = (int)py;
-		++active;
-	}
-	if (active != n) {
-		return EIO;
 	}
 	touch_report(mask, x, y);
 	return 0;
 }
